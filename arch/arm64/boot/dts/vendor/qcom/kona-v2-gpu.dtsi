reg = <5>;
qcom,gpu-freq = <0x122dee40>;
qcom,bus-freq-ddr7 = <0x3>;
qcom,bus-min-ddr7 = <0x2>;
qcom,bus-max-ddr7 = <0x9>;
qcom,bus-freq-ddr8 = <0x3>;
qcom,bus-min-ddr8 = <0x2>;
qcom,bus-max-ddr8 = <0x9>;
qcom,acd-level = <0xa02b5ffd>;
};
qcom,gpu-pwrlevel@6 {
reg = <6>;
qcom,gpu-freq = <0x0>;
qcom,bus-freq = <0x0>;
qcom,bus-min = <0x0>;
qcom,bus-max = <0x0>;
};
};
