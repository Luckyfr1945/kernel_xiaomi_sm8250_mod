&soc {
	msm_bus: qcom,kgsl-busmon {
		label = "kgsl-busmon";
		compatible = "qcom,kgsl-busmon";
		operating-points-v2 = <&gpu_opp_table_v2>;
	};

	gpu_opp_table_v2: gpu-opp-table_v2 {
		compatible = "operating-points-v2";

		opp-683000000 {
			opp-hz = /bits/ 64 <683000000>;
			opp-microvolt = <225>;
		};

		opp-670000000 {
			opp-hz = /bits/ 64 <670000000>;
			opp-microvolt = <225>;
		};

		opp-587000000 {
			opp-hz = /bits/ 64 <587000000>;
			opp-microvolt = <129>;
		};

		opp-525000000 {
			opp-hz = /bits/ 64 <525000000>;
			opp-microvolt = <129>;
		};

		opp-510000000 {
			opp-hz = /bits/ 64 <510000000>;
			opp-microvolt = <66>;
		};

		opp-490000000 {
			opp-hz = /bits/ 64 <490000000>;
			opp-microvolt = <66>;
		};

		opp-441600000 {
			opp-hz = /bits/ 64 <441600000>;
			opp-microvolt = <66>;
		};

		opp-400000000 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <1>;
		};

		opp-330000000 {
			opp-hz = /bits/ 64 <330000000>;
			opp-microvolt = <1>;
		};

		opp-305000000 {
			opp-hz = /bits/ 64 <305000000>;
			opp-microvolt = <1>;
		};

		opp-205000000 {
			opp-hz = /bits/ 64 <205000000>;
			opp-microvolt = <1>;
		};

		opp-150000000 {
			opp-hz = /bits/ 64 <150000000>;
			opp-microvolt = <1>;
		};
	};
};

&msm_gpu {
	qcom,chipid = <0x06050001>;

	/* GPU OPP data */
	operating-points-v2 = <&gpu_opp_table_v2>;

	/delete-property/qcom,initial-pwrlevel;
	/delete-node/qcom,gpu-pwrlevels;

	/* Power levels bins */
	qcom,gpu-pwrlevel-bins {
		compatible = "qcom,gpu-pwrlevel-bins";
		#address-cells = <1>;
		#size-cells = <0>;
qcom,gpu-pwrlevels-0 {
#address-cells = <0x1>;
#size-cells = <0x0>;
qcom,speed-bin = <0x0>;
qcom,initial-pwrlevel = <0x5>;
qcom,throttle-pwrlevel = <0x0>;
qcom,gpu-pwrlevel@0 {
reg = <0>;
qcom,gpu-freq = <0x22fce8c0>;
qcom,bus-freq-ddr7 = <0xb>;
qcom,bus-min-ddr7 = <0xb>;
qcom,bus-max-ddr7 = <0xb>;
qcom,bus-freq-ddr8 = <0xb>;
qcom,bus-min-ddr8 = <0xb>;
qcom,bus-max-ddr8 = <0xb>;
qcom,acd-level = <0x802b5ffd>;
};
qcom,gpu-pwrlevel@1 {
reg = <1>;
qcom,gpu-freq = <0x1f4add40>;
qcom,bus-freq-ddr7 = <0x9>;
qcom,bus-min-ddr7 = <0x9>;
qcom,bus-max-ddr7 = <0xb>;
qcom,bus-freq-ddr8 = <0x8>;
qcom,bus-min-ddr8 = <0x8>;
qcom,bus-max-ddr8 = <0xb>;
qcom,acd-level = <0x802b5ffd>;
};
