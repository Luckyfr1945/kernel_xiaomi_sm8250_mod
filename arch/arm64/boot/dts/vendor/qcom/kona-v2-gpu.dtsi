						qcom,gpu-freq = <0x8f0d180>;
						qcom,bus-freq-ddr7 = <0x02>;
						qcom,bus-min-ddr7 = <0x01>;
						qcom,bus-max-ddr7 = <0x03>;
						qcom,bus-freq-ddr8 = <0x02>;
						qcom,bus-min-ddr8 = <0x01>;
						qcom,bus-max-ddr8 = <0x03>;
						qcom,acd-level = <0xa02b5ffd>;
					};

					qcom,gpu-pwrlevel@7 {
