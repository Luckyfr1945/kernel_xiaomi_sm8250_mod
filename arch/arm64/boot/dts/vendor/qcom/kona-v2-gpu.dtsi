						qcom,bus-min-ddr7 = <0x04>;
						qcom,bus-max-ddr7 = <0x06>;
						qcom,bus-freq-ddr8 = <0x05>;
						qcom,bus-min-ddr8 = <0x04>;
						qcom,bus-max-ddr8 = <0x06>;
						qcom,acd-level = <0xa02b5ffd>;
					};

					qcom,gpu-pwrlevel@6 {
